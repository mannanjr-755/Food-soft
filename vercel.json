{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install --prefix restaurant-dashboard",
  "buildCommand": "npm run build --prefix restaurant-dashboard",
  "outputDirectory": "restaurant-dashboard/dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
